# ── Servidor ────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Seguridad ───────────────────────────────────────────────
# Clave para firmar los JWT. CAMBIAR en producción por un valor largo y aleatorio.
JWT_SECRET=cambia-esta-clave-en-produccion-por-una-larga-y-aleatoria
# Minutos de inactividad antes del cierre automático de sesión.
SESSION_IDLE_MINUTES=30
# Vida del token de acceso.
JWT_EXPIRES=8h
# Intentos de login fallidos antes de bloquear temporalmente al usuario.
MAX_LOGIN_ATTEMPTS=5
LOCK_MINUTES=15

# ── Base de datos ───────────────────────────────────────────
DB_PATH=./data/portal.db

# ── Archivos adjuntos ───────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=15

# ── Reglas de negocio ───────────────────────────────────────
# Margen mínimo (%) por debajo del cual se dispara una alerta.
MIN_MARGIN_PCT=20
# Moneda por defecto.
DEFAULT_CURRENCY=ARS

# ── Integración Odoo 19 (XML-RPC) ───────────────────────────
# Dejar ODOO_ENABLED=false para trabajar con datos de prueba locales (mock).
ODOO_ENABLED=false
ODOO_URL=https://mi-odoo.example.com
ODOO_DB=mi_base
ODOO_USERNAME=api@todoenmuebles.com
ODOO_PASSWORD=coloca-aqui-la-api-key-de-odoo
